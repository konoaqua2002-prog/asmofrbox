<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AsmoFrBoxTelegramBot</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Run on whatever compatible .NET runtime is installed (9.x, 10.x, ...)
         even if it doesn't exactly match the SDK used to build. Avoids the
         "You must install or update .NET" error on hosts with a different
         runtime version than the build machine. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin a known-good v22.x release; bump freely, the v22 API is stable. -->
    <PackageReference Include="Telegram.Bot" Version="22.10.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Baked into the EXE at build time, same trick as the WinForms app.
         Drop your real firmware_catalog.json here before publishing, or
         point CATALOG_SOURCE (env var) at a file path / https URL instead. -->
    <EmbeddedResource Include="firmware_catalog.json" Condition="Exists('firmware_catalog.json')" />
  </ItemGroup>

</Project>
